 "poems": [
  {
   "seq": "1",
   "text": "しらすげのま野の萩原ゆくさくさ君社をしめまのゝ萩原",
   "kana": "",
   "speaker": "",
   "page": 299,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "いて人は〓とのみそよき月草のうつし心はあひもおもはす",
   "kana": "",
   "speaker": "",
   "page": 299,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ほとゝきす鳴らん里に行てしかしかなく聲をきけはくるしも",
   "kana": "",
   "speaker": "",
   "page": 299,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "妹か門過ゆきがてに草結ふかせ吹とくなあはむ日まてに",
   "kana": "",
   "speaker": "",
   "page": 299,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "しなかとりゐな山ゆすり行水のなのみなかれて戀わたる哉",
   "kana": "",
   "speaker": "",
   "page": 299,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "しなかとりゐなのふし原あを山にならん時にを色はがはらん",
   "kana": "",
   "speaker": "",
   "page": 299,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "くらはしの山をたかみかかき曇りいてける月の光ともしき",
   "kana": "",
   "speaker": "猿丸大夫集",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "人妻といふはたか〓とすころものこのもとけしといふはたかゝと",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "をみなへし秋萩手をれ玉ほごの道行人もとはんこかため",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "うたの野の秋萩しのき鳴鹿の妻こふらくは我におとらし",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "玉くしけあけまく惜しきあたらよを妹にもあはて明しつる哉",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "梓弓末のたつきはしらねとも心は君によりにけるかな",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "朝日影句へる山にてる月のよそなる君を山こしにして",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "ほととほみ戀〓にけり增鏡かけたにけさは爰にみえこす",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "梓弓ひきつのへなるなのりその花咲まてに妹にあはぬかも",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "あひみねはこひ社增れみなせ川なにゝふかめて思ひそめ劔",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "をとゝしもゝそも今年もはふ葛のしたゆたひつゝあり渡る哉",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "玉襷かけねはくるしかけたれはつきてみまくのほしき君かも",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "夕月夜さすや岡への松のはのいつともわかぬ戀もする哉",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "風をいたみよせくる浪にあさりする蜑乙女子か裳裾ぬれぬる",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "ちりひちの數にもあらぬ我ゆゑに思ひわふらん妹かかなしさ",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "おほ舟のわくる所のたゆたひに物思ひ〓ぬ人のこゆゑに",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "人〓ののけけ此此らは手にまきつけてこひすそあらまし",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "我妹子にこひてあらすは秋萩のさきて散ぬる花ならましを",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "足引の山下風はふかれともよな〓〓戀はかねてさむしも",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "しなかとりゐな野を行は有馬山ゆふ霧たちぬ友なしにして",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "ひくらしの鳴つるなへに日は暮ぬと思へは山の影にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "梓弓ゆつかあらためなかひさしひかすもひきも君かまに〓〓",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "あらしをのかるやのさきに立鹿もいと我とく物は思はし",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "宿近く梅の花うゑしあちきなくまつ人のかにあやまたれけり",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "山たかみ人もすさめぬ櫻花いたくなわひそ我みはやさん",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "春雨に匂へる色もあかなくにかさへなつかしやまふきの花",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "今もかも咲句ふらんたちはなのこしまのさきの山吹の花",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "時鳥なかなく里のあまたあれはなほうとまれぬおもふ物から",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "さつきまつ山郭公打はふきいまもなかなんこそのふる聲",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "大かたの秋くるからに我身こそ悲しき物と思ひしりぬれ",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "秋萩の色つきぬれはきり〓〓す我身の〓とや物は悲しき",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "奥山に紅葉ふみ分なく鹿の聲きく時そ物はかなしき",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "秋はきぬ紅葉はやとに降しきぬ道ふみ分てとふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "萩の花散らんをのゝ露霜にぬれてをゆかむさ夜はふくとも",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "ほにいてぬ山田をもるとかり衣いなはの露にぬれぬ日はなし",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "さゝ浪やその山守はたかために今もしめゆふ君もあらなくに",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "まめなれと何そはよけく苅萱の亂れてあれとあしけくもなし",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "たかみそきゆふつけ鳥かから衣たつたの山にをりはへてなく",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "あら小田をあらすきかへしかへしてもみて社やまめ人の心を",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "をらこちのたつきもしらぬ山中におほつかなくも呼子鳥かな",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "石はしる瀧なくもかな山櫻手折てもこむみぬ人のため",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "折とらはをしけにもあるか櫻花いさやとかりて散まてはみむ",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "こんよにもはやなりなゝむ目の前につれなき人を昔と思はん",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
